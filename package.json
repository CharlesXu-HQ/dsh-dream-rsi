{
  "name": "dsh-dream-rsi",
  "version": "0.1.0",
  "description": "Experimental Dream-RSI exploration-policy plugin for DeepSeek Harness",
  "license": "MIT",
  "repository": "github:CharlesXu-HQ/dsh-dream-rsi",
  "type": "module",
  "main": "./lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "docs/release.md", "examples/toy"],
  "keywords": ["dsh-plugin", "deepseek-harness", "dream-rsi", "recursive-self-improvement", "cordis"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
